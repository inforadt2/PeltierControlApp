@inherits LayoutComponentBase

<div class="page d-flex flex-column flex-md-row">
    <div class="sidebar bg-dark text-white p-3" style="min-width: 250px; min-height: 100vh;">
        <h4>펠티어 제어 센터</h4>
        <hr />
        <nav class="nav flex-column">
            <NavLink class="nav-link text-white py-2" href="" Match="NavLinkMatch.All">
                🏠 대시보드
            </NavLink>
            <a class="nav-link text-white py-2" href="logs" target="_blank">
                📋 로그
            </a>
            <a class="nav-link text-white py-2" href="settings" target="_blank">
                ⚙️ 설정
            </a>
        </nav>
    </div>

    <main class="flex-grow-1 bg-light">
        <div class="top-row px-4 border-bottom bg-white d-flex align-items-center" style="height: 3.5rem;">
            <span class="text-muted">실시간 모니터링 시스템</span>
        </div>

        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>