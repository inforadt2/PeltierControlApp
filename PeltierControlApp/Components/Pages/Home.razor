@page "/"
@using PeltierControlApp.Services
@inject PeltierService Service
@inject PeltierService PeltierService  
@implements IDisposable

<div class="container mt-4">
    <div class="card shadow p-4 text-center">
        <h2 class="mb-4">🌡️ Peltier Control (PT100)</h2>

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="p-4 border rounded bg-primary text-white">
                    <h5>현재 온도 (PT100)</h5>
                    <h1 class="display-2">@Service.Current.Pt100.ToString("F1") °C</h1>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-4 border rounded bg-info text-white">
                    <h5>현재 습도 (SEN0546)</h5>
                    <h1 class="display-2">@Service.Current.Hum.ToString("F0") %</h1>
                </div>
            </div>
        </div>

        <div class="p-3 border rounded bg-light">
            <div class="row align-items-center justify-content-center">
                <div class="col-md-4">
                    <input type="number" @bind="inputTarget" class="form-control form-control-lg" step="0.5" />
                    <button class="btn btn-dark w-100 mt-2" @onclick="() => Service.SetTarget(inputTarget)">목표 온도 설정</button>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-success btn-lg w-100 mb-2" @onclick="() => Service.StartDevice()">시작</button>
                    <button class="btn btn-danger btn-lg w-100" @onclick="HandleStop">정지</button>
                </div>
            </div>
            <div class="mt-3">
                <strong>설정된 타겟: @Service.Current.Set.ToString("F1") °C</strong>
            </div>
        </div>
    </div>
</div>

@code {
    private double inputTarget = 25.0;

    protected override void OnInitialized()
    {
        // PeltierService(소문자 시작 인스턴스)를 사용해야 함
        PeltierService.OnDataUpdated += NotifyDataChanged;
    }
    // 데이터가 업데이트될 때 실행될 메서드
    private async void NotifyDataChanged()
    {
        // UI 스레드에서 화면 갱신을 강제함
        await InvokeAsync(StateHasChanged);
    }
    private async void Refresh()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void HandleStop()
    {
        Service.StopDevice();
        Service.Current.Set = 0; // 즉시 0으로 표시
        StateHasChanged();
    }

    public void Dispose()
    {
        // 메모리 누수 방지를 위해 이벤트 해제
        PeltierService.OnDataUpdated -= NotifyDataChanged;
    }
}