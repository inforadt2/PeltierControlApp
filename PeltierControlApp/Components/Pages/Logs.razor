@page "/logs"
@using PeltierControlApp.Services
@inject SettingsService SettingsService

<PageTitle>로그 파일 목록</PageTitle>

<div class="container py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">📋 로그 파일 목록</h5>
            <button class="btn btn-sm btn-outline-light" @onclick="Refresh">🔄 새로고침</button>
        </div>
        <div class="card-body p-0">
            @if (files.Count == 0)
            {
                <div class="p-4 text-center text-muted">저장된 로그 파일이 없습니다.</div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>파일명</th>
                            <th>크기</th>
                            <th>저장 시각</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in files)
                        {
                            <tr>
                                <td class="align-middle">@f.Name</td>
                                <td class="align-middle text-muted small">@FormatSize(f.Length)</td>
                                <td class="align-middle text-muted small">@f.LastWriteTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="align-middle text-end">
                                    <a href="/logs/view?file=@Uri.EscapeDataString(f.Name)" target="_blank" class="btn btn-sm btn-outline-primary">
                                        🔍 새 탭으로 보기
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <div class="card-footer text-muted small">
            저장 폴더: @SettingsService.Settings.LoggingFolder
        </div>
    </div>
</div>

@code {
    private List<FileInfo> files = [];

    protected override void OnInitialized() => LoadFiles();

    private void LoadFiles()
    {
        var folder = SettingsService.Settings.LoggingFolder;
        if (!Directory.Exists(folder))
        {
            files = [];
            return;
        }
        files = new DirectoryInfo(folder)
            .GetFiles("peltier_*.csv")
            .OrderByDescending(f => f.LastWriteTime)
            .ToList();
    }

    private void Refresh() => LoadFiles();

    private static string FormatSize(long bytes) =>
        bytes < 1024 ? $"{bytes} B" : $"{bytes / 1024.0:F1} KB";
}
