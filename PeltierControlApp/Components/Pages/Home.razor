@page "/"
@using PeltierControlApp.Services
@using Microsoft.AspNetCore.Http
@inject PeltierService Service
@inject SettingsService ConfigService
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@implements IDisposable

<div class="container py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">🌡️ 실시간 상태 모니터링</h5>
            @if (Service.IsConnected)
            {
                <span class="badge bg-success">● 장치 연결됨</span>
            }
            else
            {
                <span class="badge bg-danger">● 장치 미연결</span>
            }
        </div>

        <div class="card-body">
            @if (!Service.IsConnected)
            {
                <div class="alert alert-warning text-center fw-bold">
                    ⚠️ 장치가 연결되지 않았습니다. 포트 상태를 확인하세요. (로깅 중단됨)
                </div>
            }

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="p-4 border rounded-3 bg-light text-center shadow-sm">
                        <p class="text-muted mb-1 small fw-bold">현재 온도 (PT100)</p>
                        <h1 class="display-4 fw-bold text-primary mb-0">@Service.Current.Pt100.ToString("F1")<span class="fs-5">°C</span></h1>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-4 border rounded-3 bg-light text-center shadow-sm">
                        <p class="text-muted mb-1 small fw-bold">현재 온도 (SEN0546)</p>
                        <h1 class="display-4 fw-bold text-success mb-0">@Service.Current.SenT.ToString("F1")<span class="fs-5">°C</span></h1>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-4 border rounded-3 bg-light text-center shadow-sm">
                        <p class="text-muted mb-1 small fw-bold">현재 습도 (SEN0546)</p>
                        <h1 class="display-4 fw-bold text-info mb-0">@Service.Current.Hum.ToString("F0")<span class="fs-5">%</span></h1>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white shadow-sm d-flex justify-content-between align-items-center">
                        <span class="text-secondary small fw-bold">설정 온도</span>
                        <span class="h4 fw-bold mb-0">@Service.Current.Set.ToString("F1")°C</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white shadow-sm d-flex justify-content-between align-items-center">
                        <span class="text-secondary small fw-bold">파워 출력</span>
                        <span class="h4 fw-bold text-warning mb-0">@Service.Current.Pwr%</span>
                    </div>
                </div>
            </div>

            @if (Service.IsLogging)
            {
                <div class="alert alert-success d-flex align-items-center gap-2 py-2 mb-3">
                    <span class="spinner-grow spinner-grow-sm text-success" role="status"></span>
                    <span class="small fw-bold">로깅 중 — @ConfigService.Settings.LoggingFolder</span>
                    <button class="btn btn-sm btn-outline-success ms-auto" @onclick="OpenLogFolder">📂 폴더 보기</button>
                </div>
            }

            <div class="p-4 border-top">
                <div class="row g-3 align-items-end justify-content-center">
                    <div class="col-md-5">
                        <label class="form-label small fw-bold">목표 온도 설정 (5°C ~ 35°C)</label>
                        <input type="number" @bind="inputTarget" class="form-control"
                               disabled="@(!Service.IsConnected)" step="0.5" />
                    </div>
                    <div class="col-md-4">
                        @if (Service.Current.Set == 0)
                        {
                            @if (CooldownRemaining > 0)
                            {
                                <button class="btn btn-secondary btn-lg w-100" disabled>
                                    ⏳ 재가동 대기 (@CooldownRemaining초)
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-success btn-lg w-100"
                                        @onclick="() => OnControlAction(HandleStart)"
                                        disabled="@(!Service.IsConnected)">
                                    ▶️ 가동 시작
                                </button>
                            }
                        }
                        else
                        {
                            <button class="btn btn-danger btn-lg w-100"
                                    @onclick="() => OnControlAction(HandleStop)"
                                    disabled="@(!Service.IsConnected)">
                                ⏹️ 가동 정지
                            </button>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private double inputTarget = 20.0;
    private string userIp = "Unknown";
    private DateTime? _stopTime = null;
    private int CooldownRemaining => _stopTime.HasValue
        ? Math.Max(0, 10 - (int)(DateTime.Now - _stopTime.Value).TotalSeconds)
        : 0;

    protected override void OnInitialized()
    {
        Service.OnDataUpdated += NotifyDataChanged;
        userIp = HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString() ?? "Unknown";
    }

    // 5. 제어권 확인 로직
    private async Task OnControlAction(Action action)
    {
        // 현재 제어 중인 IP가 있고, 내 IP와 다른 경우 확인 창 표시
        if (!string.IsNullOrEmpty(Service.ControllerIp) && Service.ControllerIp != userIp)
        {
            bool confirm = await JS.InvokeAsync<bool>("confirm",
                $"현재 다른 PC({Service.ControllerIp})에서 장치를 제어 중입니다. 제어권을 해제하고 현재 PC에서 컨트롤 하시겠습니까?");

            if (!confirm) return;
        }

        // 제어권 획득 및 액션 실행
        Service.TakeControl(userIp);
        action.Invoke();
    }

    private async void NotifyDataChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void HandleStart()
    {
        // 3. 온도 범위 제한 (10도 ~ 35도)
        if (inputTarget < 5 || inputTarget > 35)
        {
            JS.InvokeVoidAsync("alert", "설정 온도는 5°C에서 35°C 사이여야 합니다.");
            return;
        }
        Service.SetTarget(inputTarget);
        Service.StartDevice();
    }

    private void HandleStop()
    {
        Service.StopDevice();
        Service.Current.Set = 0;
        _stopTime = DateTime.Now;
        StateHasChanged();
    }

    private void OpenLogFolder()
    {
        var folder = ConfigService.Settings.LoggingFolder;
        try
        {
            if (!Directory.Exists(folder))
                Directory.CreateDirectory(folder);
            System.Diagnostics.Process.Start("explorer.exe", folder);
        }
        catch { }
    }

    public void Dispose()
    {
        Service.OnDataUpdated -= NotifyDataChanged;
    }
}
