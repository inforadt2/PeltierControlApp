@page "/"
@using PeltierControlApp.Services
@inject PeltierService Service
@implements IDisposable

<PageTitle>펠티어 제어 대시보드</PageTitle>

<div class="container py-4">
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0 fw-bold text-center">🌡️ 실시간 상태 모니터링</h5>
        </div>

        <div class="card-body bg-white p-4">
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-4 border rounded-3 bg-light text-center shadow-sm">
                        <p class="text-muted mb-1 small fw-bold">현재 온도 (PT100)</p>
                        <h1 class="display-3 fw-bold text-primary mb-0">@Service.Current.Pt100.ToString("F1")<span class="fs-4">°C</span></h1>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-4 border rounded-3 bg-light text-center shadow-sm">
                        <p class="text-muted mb-1 small fw-bold">현재 습도 (SEN0546)</p>
                        <h1 class="display-3 fw-bold text-info mb-0">@Service.Current.Hum.ToString("F0")<span class="fs-4">%</span></h1>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white shadow-sm d-flex justify-content-between align-items-center">
                        <span class="text-secondary small fw-bold">설정 온도</span>
                        <span class="h4 fw-bold mb-0">@Service.Current.Set.ToString("F1")°C</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white shadow-sm d-flex justify-content-between align-items-center">
                        <span class="text-secondary small fw-bold">파워 출력</span>
                        <span class="h4 fw-bold text-warning mb-0">@Service.Current.Pwr%</span>
                    </div>
                </div>
            </div>

            <div class="p-4 border-top">
                <div class="row g-3 align-items-end justify-content-center">
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-dark">목표 온도 설정 (°C)</label>
                        <input type="number" @bind="inputTarget" class="form-control form-control-lg border-primary text-center" step="0.5" />
                    </div>
                    <div class="col-md-4">
                        @if (Service.Current.Set == 0)
                        {
                            <button class="btn btn-success btn-lg w-100 py-3 fw-bold shadow-sm" @onclick="HandleStart">
                                ▶️ 가동 시작
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-danger btn-lg w-100 py-3 fw-bold shadow-sm" @onclick="HandleStop">
                                ⏹️ 가동 정지
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private double inputTarget = 20.0;

    protected override void OnInitialized()
    {
        Service.OnDataUpdated += NotifyDataChanged; //
    }

    private async void NotifyDataChanged()
    {
        await InvokeAsync(StateHasChanged); //
    }

    private void HandleStart()
    {
        Service.SetTarget(inputTarget); //
        Service.StartDevice(); //
    }

    private void HandleStop()
    {
        Service.StopDevice(); //
        Service.Current.Set = 0; // 즉시 UI 초기화
        StateHasChanged();
    }

    public void Dispose()
    {
        Service.OnDataUpdated -= NotifyDataChanged; //
    }
}