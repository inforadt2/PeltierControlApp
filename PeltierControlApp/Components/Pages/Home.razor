@page "/"
@using PeltierControlApp.Services
@inject PeltierService Service
@inject PeltierService PeltierService
@implements IDisposable
<PageTitle>Bubbler Temp.Cotrl Dashboard</PageTitle>
<div class="container mt-4">
    <div class="card shadow p-4 text-center">
        <h2 class="mb-4">🌡️ Bubbler Temp.Cotrl Dashboard</h2>

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="p-4 border rounded bg-primary text-white h-100">
                    <h5>현재 온도 (PT100)</h5>
                    <h1 class="display-2">@Service.Current.Pt100.ToString("F1") °C</h1>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-4 border rounded bg-info text-white h-100">
                    <h5>현재 습도 (SEN0546)</h5>
                    <h1 class="display-2">@Service.Current.Hum.ToString("F0") %</h1>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="p-3 border rounded bg-secondary text-white h-100">
                    <h5>설정된 목표 온도</h5>
                    <h1 class="display-4">@Service.Current.Set.ToString("F1") °C</h1>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 border rounded bg-warning text-dark h-100">
                    <h5>파워 퍼센테이지</h5>
                    <h1 class="display-4">@Service.Current.Pwr %</h1>
                </div>
            </div>
        </div>

        <div class="p-4 border rounded bg-light">
            <div class="row align-items-center justify-content-center">
                <div class="col-md-5">
                    <label class="form-label fw-bold">목표 온도 입력</label>
                    <input type="number" @bind="inputTarget" class="form-control form-control-lg text-center" step="0.5" />
                </div>
                <div class="col-md-4 mt-4 mt-md-0">
                    @if (Service.Current.Set == 0)
                    {
                        <button class="btn btn-success btn-lg w-100 py-3 shadow" @onclick="HandleStart">
                            <i class="fas fa-play me-2"></i>작동 시작
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-danger btn-lg w-100 py-3 shadow" @onclick="HandleStop">
                            <i class="fas fa-stop me-2"></i>작동 정지
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private double inputTarget = 25.0;

    protected override void OnInitialized()
    {
        PeltierService.OnDataUpdated += NotifyDataChanged;
    }

    private async void NotifyDataChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void HandleStart()
    {
        // 입력된 온도를 먼저 전송하고 시작 명령을 보냄
        Service.SetTarget(inputTarget);
        Service.StartDevice();
        StateHasChanged();
    }

    private void HandleStop()
    {
        Service.StopDevice();
        Service.Current.Set = 0; // 즉시 UI에서 설정온도를 0으로 초기화
        StateHasChanged();
    }

    public void Dispose()
    {
        PeltierService.OnDataUpdated -= NotifyDataChanged;
    }
}